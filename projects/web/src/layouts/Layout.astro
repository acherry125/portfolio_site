---
import glassesIcon from '../assets/glasses.svg?url';
import { SITE_URL, getPage, pageSchema } from '../lib/site.mjs';

interface Props {
  title?: string;
  description?: string;
  portfolio?: boolean;
  skipTarget?: string;
  fonts?: 'portfolio' | 'case-study' | 'legacy';
}

const page = getPage(Astro.url.pathname);
const canonical = SITE_URL + page.path;
const posthogToken = import.meta.env.PROD ? import.meta.env.PUBLIC_POSTHOG_KEY : undefined;
const posthogHost = import.meta.env.PROD ? import.meta.env.PUBLIC_POSTHOG_HOST : undefined;
const {
  title = page.title,
  description = page.description,
  portfolio = false,
  skipTarget = 'work',
  fonts = portfolio ? 'portfolio' : 'legacy',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-posthog-key={posthogToken} data-posthog-host={posthogHost}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={glassesIcon} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Alexander Cherry" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Alexander Cherry" />
    <meta property="og:image" content={`${SITE_URL}/seo/${page.image}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={page.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE_URL}/seo/${page.image}.png`} />
    <meta name="twitter:image:alt" content={page.imageAlt} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(pageSchema(page)).replace(/</g, '\u003c')}
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {
      fonts === 'legacy' && (
        <link
          href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Syne:wght@400;500;600;700;800&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300&display=swap"
          rel="stylesheet"
        />
      )
    }
    {
      fonts !== 'legacy' && (
        <link
          href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
          rel="stylesheet"
        />
      )
    }
    {
      fonts === 'case-study' && (
        <link
          href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap"
          rel="stylesheet"
        />
      )
    }
    <script>
      import { initializeAnalytics } from '../scripts/analytics';
      const { posthogKey, posthogHost } = document.documentElement.dataset;
      void initializeAnalytics(posthogKey, posthogHost);
    </script>
  </head>
  <body style={portfolio ? 'background: #f3f1ec' : undefined}>
    <a href={`#${skipTarget}`} class="skip-link">Skip to main content</a>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --cherry: #c0392b;
    --cherry-dark: #a93226;
    --cherry-light: #e74c3c;
    --cream: #faf7f2;
    --cream-warm: #f0ebe3;
    --ink: #1a1a1a;
    --ink-muted: rgba(26, 26, 26, 0.4);
    --ink-subtle: rgba(26, 26, 26, 0.15);
    --font-serif: 'Instrument Serif', Georgia, serif;
    --font-sans: 'Syne', system-ui, sans-serif;
    --font-mono: 'DM Mono', 'Fira Code', monospace;
    --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
    --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-sans);
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  :focus-visible {
    outline: 2px solid var(--cherry);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .skip-link {
    position: absolute;
    left: -9999px;
    top: auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .skip-link:focus {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: auto;
    height: auto;
    z-index: 9999;
    background: var(--cherry);
    color: var(--cream);
    padding: 0.5rem 1.25rem;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
    outline: none;
  }

  ::selection {
    background: var(--cherry);
    color: var(--cream);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
